<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CC98.Discover"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CC98"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:image="using:CC98.Controls"
    xmlns:obj="using:CC98.Objects"
    xmlns:cv="using:CC98.Services.Converters"
    xmlns:tool="using:CommunityToolkit.WinUI.UI.Controls" xmlns:local1="using:CC98.Controls"
    Background="{ThemeResource DesktopAcrylicTransparentBrush}">
    <Page.Resources>

        <DataTemplate x:Key="ImagePost" x:DataType="obj:TopicInfo">
            <Grid Padding="8"  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="5" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>

                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <HyperlinkButton Grid.Row="0"   x:Name="Person" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" Margin="1,0,0,0" Click="Person_Click" Tag="{x:Bind}">
                    <TextBlock Text="{x:Bind UserName}" VerticalAlignment="Center" FontSize="12"></TextBlock>
                </HyperlinkButton>
                <TextBlock Grid.Row="0" HorizontalAlignment="Right" Text="{x:Bind Time}"  FontSize="10"   Foreground="{ThemeResource TextFillColorSecondaryBrush}"></TextBlock>
                <StackPanel Grid.Row="1" Padding="10" CornerRadius="4" Spacing="15" Height="Auto" Orientation="Vertical">
                    <HyperlinkButton Padding="10"  Height="Auto" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Tag="{x:Bind Id}" x:Name="MainText" Click="MainText_Click">
                        <TextBlock Text="{x:Bind Title}"  TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"></TextBlock>
                    </HyperlinkButton>

                    <ItemsView ItemsSource="{x:Bind MediaContent.Thumbnail}">
                        <ItemsView.Layout>
                            <UniformGridLayout  MaximumRowsOrColumns="3" ItemsJustification="Start"  MinColumnSpacing="15" MinRowSpacing="15" ></UniformGridLayout>
                        </ItemsView.Layout>
                        <ItemsView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <ItemContainer CacheMode="BitmapCache">
                                    <image:SmartImage Source="{x:Bind}" Tag="{x:Bind}" Stretch="UniformToFill" MaxWidth="300" Tapped="Image_Tapped" ></image:SmartImage>
                                </ItemContainer>
                            </DataTemplate>
                        </ItemsView.ItemTemplate>
                    </ItemsView>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Row="2" Spacing="10">
                    <Button Background="Transparent"  HorizontalAlignment="Left" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="5" >
                            <ic:SymbolIcon Symbol="Chat" FontSize="11"></ic:SymbolIcon>
                            <TextBlock Text="{x:Bind ReplyCount}" Grid.Row="2"  HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"></TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Background="Transparent"  HorizontalAlignment="Left" Margin="0,10,0,0" >
                        <StackPanel Orientation="Horizontal" Spacing="5" >
                            <ic:SymbolIcon Symbol="Fire" FontSize="11"></ic:SymbolIcon>
                            <TextBlock Text="{x:Bind HitCount}"   HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"></TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Button Grid.Row="3" HorizontalAlignment="Right" Background="Transparent" Margin="0,10,0,0">
                    <ic:SymbolIcon Symbol="MoreHorizontal" FontSize="11"></ic:SymbolIcon>
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="收藏" >
                                <MenuFlyoutItem.Icon>
                                    <ic:SymbolIcon Symbol="Star"></ic:SymbolIcon>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="复制帖子ID" >
                                <MenuFlyoutItem.Icon>
                                    <ic:SymbolIcon Symbol="Link"></ic:SymbolIcon>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </DataTemplate>
    </Page.Resources>
    
    
    
    
    <Grid Padding="15"  ColumnSpacing="10" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6*"></ColumnDefinition>
            <ColumnDefinition Width="2*"  ></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid  ColumnSpacing="10" Grid.Column="0" Grid.Row="0" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Button x:Name="Backward" Grid.Column="0" Tag="Back" Click="NaviBar_Click" Padding="7">
                <ic:SymbolIcon Symbol="ChevronLeft"></ic:SymbolIcon>
            </Button>
            <Button Tag="Forward" Grid.Column="1" Click="NaviBar_Click" Padding="7"  >
                <ic:SymbolIcon Symbol="ChevronRight"></ic:SymbolIcon>
            </Button>
            <Button Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"  >
                <TextBlock Text="第 1 页" x:Name="PageIndex"  ></TextBlock>
            </Button>
        </Grid>
        <Button Grid.Column="1" Grid.Row="0"  x:Name="RefRandomTiles" Click="RefRandomTiles_Click" Padding="7"  BorderThickness="0" >
            <ic:SymbolIcon Symbol="ArrowSync" ></ic:SymbolIcon>
        </Button>

        <ScrollViewer Grid.Row="1" Grid.Column="0" x:Name="NewTopicViewer">
            <ItemsRepeater ItemTemplate="{StaticResource ImagePost}" ItemsSource="{x:Bind topics}" VerticalCacheLength="48">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Vertical" Spacing="15"></StackLayout>
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>


        <ScrollViewer   Grid.Row="1" Grid.Column="1"  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"   CornerRadius="5" Padding="10" >
            <ItemsRepeater x:Name="RandomTiles" ItemsSource="{x:Bind randomTopics}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Vertical" Spacing="5"></StackLayout>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="obj:SimpleTopicInfo">
                        <HyperlinkButton Padding="8" Foreground="{ThemeResource TextFillColorSecondaryBrush}" x:Name="RandomPost" Click="RandomPost_Click" DataContext="{x:Bind}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="45"></ColumnDefinition>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <ic:SymbolIcon Symbol="Chat" Grid.Column="0" ></ic:SymbolIcon>
                                <TextBlock Text="{x:Bind Title}" FontSize="13" Grid.Column="1" TextWrapping="Wrap"></TextBlock>
                            </Grid>
                            
                        </HyperlinkButton>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

        </ScrollViewer>
        <local:InfoFlower x:Name="Flower" Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom"></local:InfoFlower>
    </Grid>







</Page>
