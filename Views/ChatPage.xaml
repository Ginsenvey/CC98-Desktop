<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="CC98.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:obj="using:CC98.Objects"
    xmlns:picture="using:CC98.Controls.Picture"
    xmlns:ubbTextBlock="using:CC98.Controls.UbbTextBlock"
    xmlns:infoFlower="using:CC98.Controls.InfoFlower"
    xmlns:tool="using:CommunityToolkit.WinUI.Controls"
    xmlns:dev="using:DevWinUI"
    Background="{ThemeResource DesktopAcrylicTransparentBrush}">

   
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"></ColumnDefinition>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition Width="7*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <dev:TextBox Grid.Row="0" Grid.Column="0" x:Name="SearchUser" PlaceholderText="搜索用户名" HorizontalAlignment="Stretch" Margin="12" >
            <Button x:Name="Confirm">
                <ic:SymbolIcon Symbol="Search"></ic:SymbolIcon>
            </Button>
        </dev:TextBox>
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Height="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1"></Border>
        <ListView Grid.Row="2" Grid.Column="0" x:Name="UserList" SelectionChanged="ContactRepeater_SelectionChanged"
          ItemsSource="{x:Bind ChatInfoList}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="obj:ChatInfo">
                    <Grid Padding="10" RowSpacing="5" ColumnSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" CornerRadius="5" Height="45"
                        Width="45">
                            <picture:Picture Src="{x:Bind PortraitUrl}" Stretch="UniformToFill"
                                     LoadImageCallback="{StaticResource PortraitLoader}" />
                        </Border>
                        <TextBlock Text="{x:Bind Name}" Grid.Column="1" Grid.Row="0" FontSize="15" />
                        <TextBlock Text="{x:Bind LastContent}" Grid.Column="1" Grid.Row="1" FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="1" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Border Grid.Column="1" Grid.RowSpan="3" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Width="1" BorderThickness="1">
            <Border.RenderTransform>
                <TranslateTransform X="6"></TranslateTransform>
            </Border.RenderTransform>
        </Border>
        <tool:GridSplitter Grid.Column="1" Grid.Row="0" Grid.RowSpan="3" Canvas.ZIndex="2">
            <tool:GridSplitter.RenderTransform>
                <TranslateTransform X="6" ></TranslateTransform>
            </tool:GridSplitter.RenderTransform>
        </tool:GridSplitter>
        <Grid Grid.Row="0" Grid.Column="2" Margin="15,0,15,0">
            <TextBlock FontFamily="{StaticResource HarmonySansBold}" FontSize="18" VerticalAlignment="Center" Foreground="LightSeaGreen" Text="{x:Bind ((obj:ChatInfo)UserList.SelectedItem).Name,Mode=OneWay}"></TextBlock>
            <StackPanel   Orientation="Horizontal" HorizontalAlignment="Right"  Spacing="8">
                <Button Click="More_Click" x:Name="More" Padding="7" BorderThickness="1"
ToolTipService.ToolTip="查看更多">
                    <ic:SymbolIcon Symbol="ChevronUp" FontSize="16" />
                </Button>
                <Button Click="Ref_Click" x:Name="Ref" Padding="7" BorderThickness="1"
ToolTipService.ToolTip="最新信息">
                    <ic:SymbolIcon Symbol="ArrowSync" FontSize="16" />
                </Button>
            </StackPanel>
        </Grid>
        
        <Grid Grid.Row="2" Grid.Column="2" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="1"/>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition MinHeight="60" MaxHeight="130" />
            </Grid.RowDefinitions>
            
            <ScrollViewer x:Name="HistoryViewer" Padding="10,0,15,0" Grid.Row="0">
                <ItemsRepeater x:Name="MessagesList" ItemsSource="{x:Bind Messages}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="obj:ChatMessage">
                            <Border Margin="0,10"
                            HorizontalAlignment="{x:Bind IsMe,Converter={StaticResource AlignmentConverter}}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            Background="Transparent" BorderThickness="1" CornerRadius="5" Padding="10"
                            Height="Auto" MaxWidth="350" MinWidth="200">
                                <StackPanel>
                                    <ubbTextBlock:UbbTextBlock UbbText="{x:Bind Content}"
                                                               HorizontalAlignment="{x:Bind IsMe,Converter={StaticResource AlignmentConverter}}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       QuoteBackground="{ThemeResource QuoteBackgroundBrush}"
                                                       BoldFontFamily="{StaticResource HarmonySansBold}"
                                                        MediaClicked="UbbTextBlock_MediaClicked" />
                                    <TextBlock Text="{x:Bind Time}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       HorizontalAlignment="Right" FontSize="10" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
            <Border Grid.Row="1" Height="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1"></Border>
            <Grid Grid.Row="2" Margin="10,0,10,0">
                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" Spacing="5" >
                    <HyperlinkButton  Padding="7">
                        <FontIcon Glyph="&#xED58;" />
                    </HyperlinkButton>
                    <HyperlinkButton  Padding="7">
                        <ic:SymbolIcon Symbol="Image"></ic:SymbolIcon>
                    </HyperlinkButton>
                    <HyperlinkButton Padding="7">
                        <ic:SymbolIcon Symbol="Folder"></ic:SymbolIcon>
                    </HyperlinkButton>
                    <HyperlinkButton Padding="7">
                        <ic:SymbolIcon Symbol="TextBold"></ic:SymbolIcon>
                    </HyperlinkButton>
                    <HyperlinkButton Padding="7">
                        <ic:SymbolIcon Symbol="TextItalic"></ic:SymbolIcon>
                    </HyperlinkButton>
                    <HyperlinkButton Padding="7">
                        <ic:SymbolIcon Symbol="TextStrikethrough"></ic:SymbolIcon>
                    </HyperlinkButton>
                    <HyperlinkButton  Padding="7">
                        <ic:SymbolIcon Symbol="CommentQuote"></ic:SymbolIcon>
                    </HyperlinkButton>
                </StackPanel>
                <HyperlinkButton x:Name="SendButton" HorizontalAlignment="Right" Padding="7">
                    <ic:SymbolIcon Symbol="Send"></ic:SymbolIcon>
                </HyperlinkButton>
            </Grid>
            

            <TextBox x:Name="ReplyBody" Grid.Row="3" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" CornerRadius="0" />
        </Grid>
        <infoFlower:InfoFlower x:Name="Flower" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
    </Grid>

</Page>