<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CC98.Index"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CC98"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Disabled"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:lab="using:CommunityToolkit.Labs.WinUI"
    xmlns:obj="using:CC98.Objects"
    xmlns:cv="using:CC98.Services.Converters"
    xmlns:tool="using:CommunityToolkit.WinUI.Controls"
    
    Background="{ThemeResource CardGradient1Brush}">
    <Page.Resources>
        <DataTemplate x:Key="Presenter" x:DataType="obj:IndexTopic">
            <HyperlinkButton  PointerEntered="ContentCard_PointerEntered" PointerExited="ContentCard_PointerExited" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" x:Name="TopicItem" Click="TopicItem_Click" Tag="{x:Bind Id}" CornerRadius="0" Height="53" >
                <HyperlinkButton.RenderTransform>
                    <TranslateTransform x:Name="CardTranslate" X="0" Y="0"/>
                </HyperlinkButton.RenderTransform>
                <Grid Padding="5" ColumnSpacing="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Title}" Grid.Column="1" FontSize="14"  VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" MaxLines="1"></TextBlock>
                    <Border Grid.Column="0" Background="{ThemeResource MarkdownBackgroudBrush}" CornerRadius="3" VerticalAlignment="Center" Padding="3" Visibility="{x:Bind IsHotTopic}">
                        <TextBlock Text="{x:Bind BoardName}"   FontSize="12" Grid.Row="0"   Foreground="{ThemeResource AccentAAFillColorSecondaryBrush}"></TextBlock>
                    </Border>
                </Grid>
            </HyperlinkButton>
        </DataTemplate>
        <DataTemplate x:Key="SectionCardStyle" x:DataType="obj:SectionCard">
            <Grid RowSpacing="5" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="5" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" MinWidth="450" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="2"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="2,0,0,0" Grid.Row="0">
                    <Border Width="4" Margin="10,20,0,15" Height="22" BorderBrush="{x:Bind HexColor,Converter={StaticResource HexToColorBrush}}" BorderThickness="4"></Border>
                    <TextBlock Text="{x:Bind SectionName}" Margin="10,20,10,15" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"></TextBlock>
                </StackPanel>
                <Border Grid.Row="1" Height="2" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" HorizontalAlignment="Stretch" BorderThickness="2"></Border>
                <ItemsRepeater Grid.Row="2" x:Name="TileList" ItemTemplate="{StaticResource Presenter}" ItemsSource="{x:Bind IndexTopics}" ></ItemsRepeater>
            </Grid>
        </DataTemplate>
    </Page.Resources>
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="96"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <FlipView  Grid.Row="0"  x:Name="RecomList" ItemsSource="{x:Bind flipTopics}" VerticalAlignment="Top" CornerRadius="0,0,6,6">
            <FlipView.Background>
                <ImageBrush x:Name="ThemePresenter" Opacity="0.6" Stretch="UniformToFill"></ImageBrush>
            </FlipView.Background>
            <FlipView.ItemTemplate>
                <DataTemplate x:DataType="obj:FlipTopic">
                    <Grid Padding="20" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <ic:SymbolIcon Symbol="DesignIdeas" FontSize="26" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"></ic:SymbolIcon>
                        <TextBlock Text="{x:Bind Content}" Grid.Row="1" Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" ></TextBlock>
                        <TextBlock  Grid.Row="0" Grid.Column="1"  FontWeight="Bold" TextDecorations="Underline">
                            <Hyperlink NavigateUri="{x:Bind Url}" Click="RecomHyperlink_Click" x:Name="RecomHyperlink">
                                <Run Text="{x:Bind Title}" ></Run>
                            </Hyperlink>
                        </TextBlock>
                        
                    </Grid>
                </DataTemplate>
            </FlipView.ItemTemplate>
        </FlipView>
        <PipsPager x:Name="Pips" Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Center"  SelectedPageIndex="{x:Bind Path=RecomList.SelectedIndex,Mode=TwoWay}"></PipsPager>
        <ScrollViewer Grid.Row="1" Margin="10,0,10,0" Padding="10">
            <ItemsRepeater x:Name="SectionRepeater" ItemTemplate="{StaticResource SectionCardStyle}" ItemsSource="{x:Bind sections}" HorizontalAlignment="Stretch" VerticalCacheLength="32">
                <ItemsRepeater.Layout>
                    <tool:StaggeredLayout ItemsStretch="Fill" ColumnSpacing="30" RowSpacing="45" DesiredColumnWidth="450"></tool:StaggeredLayout>
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>
        <CommandBar x:Name="IndexAction" Grid.Row="2" Background="{ThemeResource CardGradient1Brush}">
            <AppBarButton Label="刷新" Tag="refresh" Click="IndexAction_Click" ToolTipService.ToolTip="刷新">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE72C;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="搜索" Tag="search"  ToolTipService.ToolTip="搜索" Click="IndexAction_Click">
                <AppBarButton.Icon>
                    <ic:SymbolIcon Symbol="Search"></ic:SymbolIcon>
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="抽卡" Tag="lottery"  ToolTipService.ToolTip="抽卡" Click="IndexAction_Click">
                <AppBarButton.Icon>
                    <ic:SymbolIcon Symbol="GiftOpen"></ic:SymbolIcon>
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="统计数据" Tag="stat" ToolTipService.ToolTip="统计" Click="IndexAction_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE7BC;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="应用中心" Tag="appcenter"  ToolTipService.ToolTip="应用中心" Click="IndexAction_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE74C;" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>
        <TeachingTip x:Name="ForumStat" IsLightDismissEnabled="True" Target="{x:Bind IndexAction}" TailVisibility="Collapsed" PreferredPlacement="Top"  Unloaded="ForumStat_Unloaded" >
            <TeachingTip.HeroContent>
                <TextBlock x:Name="welcome" Text="" Margin="10,10,10,0" HorizontalAlignment="Center" Foreground="LightSeaGreen"></TextBlock>
            </TeachingTip.HeroContent>
            <TeachingTip.Content>
                <ListView x:Name="ForumStatList" >
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="obj:CardStatInfoPair">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"></ColumnDefinition>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="12" Text="{x:Bind StatItem}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"></TextBlock>
                                <TextBlock Grid.Column="1" FontSize="12" Text="{x:Bind Value}"></TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </TeachingTip.Content>
        </TeachingTip>
        <local:InfoFlower x:Name="Flower" Grid.Row="0" Grid.RowSpan="3" HorizontalAlignment="Center" VerticalAlignment="Bottom"></local:InfoFlower>
    </Grid>
</Page>
