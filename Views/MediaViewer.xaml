<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CC98.MediaViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CC98"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:share="using:CC98.Share.Controls"
    xmlns:dev="using:DevWinUI"
    xmlns:image="using:CC98.Controls"
    xmlns:ic="using:FluentIcons.WinUI"
    Title="预览">
    
    <Grid x:Name="RootGrid" >
        <Grid.RowDefinitions>
            <RowDefinition Height="48"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto" MinHeight="60"></RowDefinition>
            <RowDefinition Height="25"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" x:Name="GridTitleBar">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="120"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            
            <TextBlock Text="CC98 预览"  Margin="10,0,5,0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="15" x:Name="de"></TextBlock>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5" >
                <Button Background="Transparent"  Height="37" x:Name="zoomin" Click="zoomin_Click">
                    <ic:SymbolIcon Symbol="ZoomIn"></ic:SymbolIcon>
                </Button>  
                <TextBlock Text="100%" VerticalAlignment="Center" Width="90" HorizontalAlignment="Center" TextAlignment="Center" x:Name="zoomfactor"></TextBlock>
                <Button Background="Transparent"  Height="37" x:Name="zoomout" Click="zoomout_Click">
                    <ic:SymbolIcon Symbol="ZoomOut"></ic:SymbolIcon>
                </Button>
                <AppBarSeparator></AppBarSeparator>
                <Button Background="Transparent" Height="37" x:Name="Rotate" Click="Rotate_Click">
                    <ic:SymbolIcon Symbol="RotateRight"></ic:SymbolIcon>
                </Button>
                <Button Background="Transparent" Height="37" x:Name="CopyPic" Click="CopyPic_Click" ToolTipService.ToolTip="复制">
                    <ic:SymbolIcon Symbol="Copy" ></ic:SymbolIcon>
                </Button>
                <Button Background="Transparent"  x:Name="AddAsEmoji" Click="AddAsEmoji_Click" ToolTipService.ToolTip="添加到表情">
                    <ic:SymbolIcon Symbol="StarAdd" ></ic:SymbolIcon>
                </Button>
                <Button Background="Transparent"  Height="37" x:Name="SavePic"  ToolTipService.ToolTip="保存">
                    <ic:SymbolIcon Symbol="Save" ></ic:SymbolIcon>
                </Button>
               
            </StackPanel>
        </Grid>
        <Border Grid.Row="2" Width="100" Height="32" CornerRadius="16" Background="{ThemeResource AcrylicCardBrush}">
            <TextBlock x:Name="Posi" Text="1/1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        
        <FlipView x:Name="flipview" Grid.Row="1" ItemsSource="{x:Bind pictures,Mode=OneWay}"  SelectionChanged="FlipView_SelectionChanged" Margin="0,20,0,0" >
            
            <FlipView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <share:Picture Src="{x:Bind}" Stretch="Uniform" LoadImageCallback="{ThemeResource CustomPortraitLoader}" RenderTransformOrigin="0.5,0.5">
                        <share:Picture.RenderTransform>
                            <CompositeTransform x:Name="ImageTransform" ScaleX="1" ScaleY="1" Rotation="0"/>
                        </share:Picture.RenderTransform>
                    </share:Picture>
                </DataTemplate>
            </FlipView.ItemTemplate>
        </FlipView>
        
        
        <MediaPlayerElement Grid.Row="1" x:Name="VideoPlayer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  AreTransportControlsEnabled="True"  AutoPlay="False" Visibility="Collapsed" Margin="20" >
            <MediaPlayerElement.TransportControls>
                <MediaTransportControls IsCompact="False"/>
            </MediaPlayerElement.TransportControls>
        </MediaPlayerElement>
        <Border Grid.Row="3" Height="1" VerticalAlignment="Top" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1"></Border>
        <TextBlock x:Name="MediaInfo" Grid.Row="3" Margin="5,0,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True"></TextBlock>
    </Grid>



</Window>
