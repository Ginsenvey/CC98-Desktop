<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CC98.Focus"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CC98"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:lab="using:CommunityToolkit.Labs.WinUI"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:obj="using:CC98.Objects"
    xmlns:cv="using:CC98.Services.Converters"
    Background="{ThemeResource DesktopAcrylicTransparentBrush}">

    <Grid Padding="15,5,15,15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="60"></RowDefinition>
            <RowDefinition Height="12*"></RowDefinition>
        </Grid.RowDefinitions>
        <SelectorBar VerticalAlignment="Center" SelectionChanged="TypeChoice_SelectionChanged" x:Name="TypeChoice">
            <SelectorBarItem Text="好友动态" IsSelected="True" Tag="0"> </SelectorBarItem>
            <SelectorBarItem Text="收藏更新" Tag="1"></SelectorBarItem>
        </SelectorBar>

        <ScrollViewer Grid.Row="1"   BorderThickness="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" CornerRadius="4" >
            <ItemsRepeater x:Name="MomentRepeater" ItemsSource="{x:Bind topics}" ElementPrepared="MomentRepeater_ElementPrepared">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="obj:TopicInfo">
                        <HyperlinkButton HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" CornerRadius="0" Click="Tile_Click" DataContext="{x:Bind}">
                            <Grid Padding="0,10,0,10" ColumnSpacing="5" >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"></ColumnDefinition>
                                    <ColumnDefinition Width="4*"></ColumnDefinition>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                    <ColumnDefinition Width="40"></ColumnDefinition>
                                    <ColumnDefinition Width="70"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <ic:SymbolIcon Symbol="LeafOne"></ic:SymbolIcon>
                                <TextBlock Text="{x:Bind Title}" Grid.Column="1" VerticalAlignment="Center" MaxLines="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}"></TextBlock>
                                <TextBlock Text="{x:Bind UserName}" Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"></TextBlock>
                                <Border Grid.Column="3" Background="Transparent"  HorizontalAlignment="Left" >
                                    <StackPanel Orientation="Horizontal" Spacing="5" >
                                        <ic:SymbolIcon Symbol="Chat" FontSize="11"></ic:SymbolIcon>
                                        <TextBlock Text="{x:Bind ReplyCount}" Grid.Row="2"  HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"></TextBlock>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="4" Background="Transparent"  HorizontalAlignment="Left" >
                                    <StackPanel Orientation="Horizontal" Spacing="5" >
                                        <ic:SymbolIcon Symbol="Fire" FontSize="11"></ic:SymbolIcon>
                                        <TextBlock Text="{x:Bind HitCount}"   HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"></TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </HyperlinkButton>

                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
        <local:InfoFlower x:Name="Flower" Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom"></local:InfoFlower>

    </Grid>
</Page>
