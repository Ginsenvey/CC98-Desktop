<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CC98.Board"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CC98"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:lab="using:CommunityToolkit.Labs.WinUI"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:dev="using:DevWinUI"
    xmlns:ubb="using:UbbRender.Render"
    xmlns:obj="using:CC98.Objects"
    xmlns:cv="using:CC98.Services.Converters"
    Background="{ThemeResource DesktopAcrylicTransparentBrush}">
    <Page.BottomAppBar>
        <CommandBar>
            <AppBarButton Label="在浏览器中打开">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xEB41;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="固定">
                <AppBarButton.Icon>
                    <ic:SymbolIcon Symbol="Pin"></ic:SymbolIcon>
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="发投票">
                <AppBarButton.Icon>
                    <ic:SymbolIcon Symbol="Vote"></ic:SymbolIcon>
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="发主题">
                <AppBarButton.Icon>
                    <ic:SymbolIcon Symbol="Drafts"></ic:SymbolIcon>
                </AppBarButton.Icon>
            </AppBarButton>
            
        </CommandBar>
    </Page.BottomAppBar>
    <ScrollViewer Padding="15,0,15,0">
        <Grid>
            <StackPanel x:Name="RootGrid">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" MinHeight="45"></RowDefinition>
                        <RowDefinition Height="Auto" MinHeight="45"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"></ColumnDefinition>
                        <ColumnDefinition Width="2*"></ColumnDefinition>
                        <ColumnDefinition Width="3*"></ColumnDefinition>
                        <ColumnDefinition Width="3*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <ic:SymbolIcon x:Name="BoardSymbol" Symbol="Chat" Grid.Row="0" Grid.RowSpan="2" FontSize="22" Grid.Column="0" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"></ic:SymbolIcon>
                    <TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Text="{x:Bind boardData.Name,Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}" VerticalAlignment="Center"></TextBlock>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{x:Bind boardData.Description,Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,10,10,0"></TextBlock>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{x:Bind boardData.BoardMastersString,Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,10,10"></TextBlock>
                    <lab:TokenView Grid.Column="3" Grid.Row="0" Grid.RowSpan="2" >
                        <lab:TokenItem>
                            <TextBlock Text="{x:Bind boardData.TopicCountString,Mode=OneWay}"></TextBlock>
                        </lab:TokenItem>
                        <lab:TokenItem IsSelected="True">
                            <TextBlock Text="{x:Bind boardData.TodayCountString,Mode=OneWay}"></TextBlock>
                        </lab:TokenItem>
                    </lab:TokenView>
                </Grid>

                <Border Padding="10">
                    <ubb:UbbTextBlock x:Name="Banner" UbbText="{x:Bind boardData.BigPaper,Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Border>

                <SelectorBar>
                    <SelectorBarItem Text="最新" IsSelected="True"></SelectorBarItem>
                    <SelectorBarItem Text="置顶"></SelectorBarItem>
                    <SelectorBarItem  Text="精华"></SelectorBarItem>
                </SelectorBar>
                <Border Margin="0,10,0,0" BorderThickness="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" CornerRadius="4" >
                    <ItemsRepeater x:Name="TopicRepeater" ElementPrepared="TopicRepeater_ElementPrepared" ItemsSource="{x:Bind topics}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="obj:SimpleTopicInfo">
                                <HyperlinkButton HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" CornerRadius="0" x:Name="TileContent" DataContext="{x:Bind}" Click="TileContent_Click">
                                    <Grid Padding="5" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"></ColumnDefinition>
                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                            <ColumnDefinition Width="120"></ColumnDefinition>
                                            <ColumnDefinition Width="60"></ColumnDefinition>
                                            <ColumnDefinition Width="72"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>
                                        <ic:SymbolIcon Symbol="ChevronRight" Grid.Column="0" FontSize="14" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"></ic:SymbolIcon>
                                        <TextBlock Text="{x:Bind Title}" Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="2"></TextBlock>
                                        <TextBlock Text="{x:Bind UserName}" FontSize="13" Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"></TextBlock>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5" >
                                            <ic:SymbolIcon Symbol="Chat" FontSize="11"></ic:SymbolIcon>
                                            <TextBlock Text="{x:Bind ReplyCount}" Grid.Row="2"  VerticalAlignment="Center"  FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"></TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="5" >
                                            <ic:SymbolIcon Symbol="Fire" FontSize="11"></ic:SymbolIcon>
                                            <TextBlock Text="{x:Bind HitCount}"  VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"></TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </HyperlinkButton>

                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Border>

            </StackPanel>
            <local:InfoFlower x:Name="Flower"  HorizontalAlignment="Center" VerticalAlignment="Bottom"></local:InfoFlower>
        </Grid>
        
    </ScrollViewer>
    
</Page>
