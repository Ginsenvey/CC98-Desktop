<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CC98.Views.Board"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CC98"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:lab="using:CommunityToolkit.Labs.WinUI"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:obj="using:CC98.Objects"
    xmlns:ubbTextBlock="using:CC98.Controls.UbbTextBlock"
    xmlns:infoFlower="using:CC98.Controls.InfoFlower"
    Background="{ThemeResource DesktopAcrylicTransparentBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" Padding="15,0,15,0">
            <StackPanel>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" MinHeight="45"></RowDefinition>
                        <RowDefinition Height="Auto" MinHeight="45"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"></ColumnDefinition>
                        <ColumnDefinition Width="2*"></ColumnDefinition>
                        <ColumnDefinition Width="3*"></ColumnDefinition>
                        <ColumnDefinition Width="3*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <ic:SymbolIcon x:Name="BoardSymbol" Symbol="Chat" Grid.Row="0" Grid.RowSpan="2" FontSize="22" Grid.Column="0" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"></ic:SymbolIcon>
                    <TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Text="{x:Bind BoardData.Name,Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}" VerticalAlignment="Center"></TextBlock>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{x:Bind BoardData.Description,Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,10,10,0"></TextBlock>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{x:Bind BoardData.BoardMastersString,Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,10,10"></TextBlock>
                    <lab:TokenView Grid.Column="3" Grid.Row="0" Grid.RowSpan="2" >
                        <lab:TokenItem>
                            <TextBlock Text="{x:Bind BoardData.TopicCountString,Mode=OneWay}"></TextBlock>
                        </lab:TokenItem>
                        <lab:TokenItem IsSelected="True">
                            <TextBlock Text="{x:Bind BoardData.TodayCountString,Mode=OneWay}"></TextBlock>
                        </lab:TokenItem>
                    </lab:TokenView>
                </Grid>

                <Border Padding="10,10,10,0" x:Name="BannerBox">
                    <ubbTextBlock:UbbTextBlock x:Name="Banner" UbbText="{x:Bind BoardData.BigPaper,Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" BoldFontFamily="{StaticResource HarmonySansBold}"/>
                </Border>

                <SelectorBar x:Name="TypeSelectorBar" SelectionChanged="TypeSelectorBar_SelectionChanged">
                    <SelectorBarItem Text="最新" IsSelected="True" Tag="latest"></SelectorBarItem>
                    <SelectorBarItem Text="置顶" Tag="top"></SelectorBarItem>
                    <SelectorBarItem  Text="精华" Tag="best"></SelectorBarItem>
                </SelectorBar>
                <Border Margin="0,10,0,0" BorderThickness="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" CornerRadius="4" >
                    <ItemsRepeater x:Name="TopicRepeater" ElementPrepared="TopicRepeater_ElementPrepared" ItemsSource="{x:Bind Topics}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="obj:SimpleTopicInfo">
                                <HyperlinkButton HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" CornerRadius="0" x:Name="TileContent" DataContext="{x:Bind}" Click="TileContent_Click">
                                    <Grid Padding="0,6,0,6" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"></ColumnDefinition>
                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                            <ColumnDefinition Width="120"></ColumnDefinition>
                                            <ColumnDefinition Width="60"></ColumnDefinition>
                                            <ColumnDefinition Width="72"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>
                                        <ic:SymbolIcon Symbol="ChevronRight" Grid.Column="0" FontSize="14" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"></ic:SymbolIcon>
                                        <TextBlock Text="{x:Bind Title}" Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="2"></TextBlock>
                                        <TextBlock Text="{x:Bind UserName}" FontSize="12" Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"></TextBlock>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5">
                                            <ic:SymbolIcon Symbol="Chat" FontSize="11"></ic:SymbolIcon>
                                            <TextBlock Text="{x:Bind ReplyCount}" Grid.Row="2"  VerticalAlignment="Center"  FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"></TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="5">
                                            <ic:SymbolIcon Symbol="Fire" FontSize="11"></ic:SymbolIcon>
                                            <TextBlock Text="{x:Bind HitCount}"  VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"></TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </HyperlinkButton>

                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <CommandBar Grid.Row="1" Background="{ThemeResource CardGradient1Brush}">
            <AppBarButton Label="刷新" Tag="refresh" Click="BoardAction_Click" ToolTipService.ToolTip="刷新">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE72C;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="在浏览器中打开" Tag="browse" Click="BoardAction_Click" ToolTipService.ToolTip="在浏览器中打开">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xEB41;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="关注" Tag="pin" Click="BoardAction_Click" ToolTipService.ToolTip="关注">
                <AppBarButton.Icon>
                    <ic:SymbolIcon Symbol="Pin"></ic:SymbolIcon>
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="发投票" Tag="vote" Click="BoardAction_Click" ToolTipService.ToolTip="发投票">
                <AppBarButton.Icon>
                    <ic:SymbolIcon Symbol="Vote"></ic:SymbolIcon>
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="发主题" Tag="draft" Click="BoardAction_Click" ToolTipService.ToolTip="发主题">
                <AppBarButton.Icon>
                    <ic:SymbolIcon Symbol="Drafts"></ic:SymbolIcon>
                </AppBarButton.Icon>
            </AppBarButton>

        </CommandBar>
        <infoFlower:InfoFlower Grid.Row="0" Grid.RowSpan="2" x:Name="Flower"  HorizontalAlignment="Center" VerticalAlignment="Bottom"></infoFlower:InfoFlower>
    </Grid>
</Page>
