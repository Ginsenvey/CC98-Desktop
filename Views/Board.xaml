<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CC98.Board"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CC98"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:lab="using:CommunityToolkit.Labs.WinUI"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:tool="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:dev="using:DevWinUI"
    Background="{ThemeResource DesktopAcrylicTransparentBrush}">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
          
        </Grid.RowDefinitions>
        <Expander Grid.Row="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"  x:Name="BoardBanner" VerticalContentAlignment="Stretch" CornerRadius="6" >
            <Expander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" MinHeight="45"></RowDefinition>
                        <RowDefinition Height="Auto" MinHeight="45"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"></ColumnDefinition>
                        <ColumnDefinition Width="2*"></ColumnDefinition>
                        <ColumnDefinition Width="3*"></ColumnDefinition>
                        <ColumnDefinition Width="3*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <ic:SymbolIcon Symbol="Chat" Grid.Row="0" Grid.RowSpan="2" FontSize="22" Grid.Column="0" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"></ic:SymbolIcon>
                    <TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Text="{x:Bind CurrentBoardData.Name,Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}" VerticalAlignment="Center"></TextBlock>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{x:Bind CurrentBoardData.Description,Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,10,10,0"></TextBlock>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{x:Bind CurrentBoardData.BoardMastersString,Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,10,10"></TextBlock>
                    <lab:TokenView Grid.Column="3" Grid.Row="0" Grid.RowSpan="2" >
                        <lab:TokenItem>
                            <TextBlock Text="{x:Bind CurrentBoardData.TopicCountString,Mode=OneWay}"></TextBlock>
                        </lab:TokenItem>
                        <lab:TokenItem IsSelected="True">
                            <TextBlock Text="{x:Bind CurrentBoardData.TodayCountString,Mode=OneWay}"></TextBlock>
                        </lab:TokenItem>
                    </lab:TokenView>
                </Grid>
            </Expander.Header>
            <Expander.Content>
                <ScrollViewer MaxHeight="240">
                    <tool:MarkdownTextBlock x:Name="Banner" Text="{x:Bind CurrentBoardData.BannerText,Mode=OneWay}" CornerRadius="10"  Background="Transparent" LinkClicked="MarkdownTextBlock_LinkClicked" ImageMaxHeight="100" ImageStretch="Uniform" ImageResolving="Drawer_ImageResolving"></tool:MarkdownTextBlock>
                </ScrollViewer>
                
            </Expander.Content>
        </Expander>
        <ScrollViewer Grid.Row="1" Margin="0,10,0,10">
            <ItemsRepeater x:Name="STileList" Loaded="STileList_Loaded">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:STile">
                        <HyperlinkButton HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" CornerRadius="0" x:Name="TileContent" DataContext="{x:Bind}" Click="TileContent_Click">
                            <Grid Padding="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"></ColumnDefinition>
                                    <ColumnDefinition Width="4*"></ColumnDefinition>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <ic:SymbolIcon Symbol="{x:Bind symbol}" Grid.Column="0" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"></ic:SymbolIcon>
                                <TextBlock Text="{x:Bind text}" Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"></TextBlock>
                                <TextBlock Text="{x:Bind author}" Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"></TextBlock>
                                <StackPanel Orientation="Horizontal" Grid.Column="3" Spacing="10" VerticalAlignment="Center" >
                                    <Button Background="Transparent"  HorizontalAlignment="Left" >
                                        <StackPanel Orientation="Horizontal" Spacing="5" >
                                            <ic:SymbolIcon Symbol="Chat" FontSize="11"></ic:SymbolIcon>
                                            <TextBlock Text="{x:Bind reply}" Grid.Row="2"  HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"></TextBlock>
                                        </StackPanel>
                                    </Button>

                                    <Button Background="Transparent"  HorizontalAlignment="Left" >
                                        <StackPanel Orientation="Horizontal" Spacing="5" >
                                            <ic:SymbolIcon Symbol="Fire" FontSize="11"></ic:SymbolIcon>
                                            <TextBlock Text="{x:Bind hit}"   HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"></TextBlock>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </HyperlinkButton>

                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

        </ScrollViewer>
        <Button x:Name="BackFromBest" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" CornerRadius="9999"  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"  Width="50" Height="50" Margin="0,0,60,60" Visibility="Collapsed" Click="BackFromBest_Click">
            <ic:SymbolIcon Symbol="ArrowLeft"></ic:SymbolIcon>
        </Button>
        <dev:GooeyButton x:Name="GooeyGroup" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"    Background="{ThemeResource AccentAAFillColorDefaultBrush}" Width="50" Height="50" Margin="0,0,60,60">
            <dev:GooeyButton.Content>
                <SymbolIcon Symbol="Add"/>
            </dev:GooeyButton.Content>
            <dev:GooeyButton.Items>

                <dev:GooeyButtonItem  Background="LightSeaGreen" Width="50" Height="50" Click="Gooey_Click" x:Name="Gooey" Tag="Best" ToolTipService.ToolTip="精华帖">
                    <ic:SymbolIcon Symbol="Sparkle"></ic:SymbolIcon>
                </dev:GooeyButtonItem >
                <dev:GooeyButtonItem Background="LightBlue" Width="50" Height="50" Click="Gooey_Click" Tag="Pin" ToolTipService.ToolTip="固定到导航栏">
                    <ic:SymbolIcon Symbol="Pin" ></ic:SymbolIcon>

                </dev:GooeyButtonItem>
                <dev:GooeyButtonItem Background="LightSteelBlue" Width="50" Height="50" Click="Gooey_Click" Tag="Send" ToolTipService.ToolTip="发帖">
                    <ic:SymbolIcon Symbol="Send" ></ic:SymbolIcon>
                </dev:GooeyButtonItem>
            </dev:GooeyButton.Items>
        </dev:GooeyButton>

        <ContentDialog Title="发表主题" x:Name="PostPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ContentDialog.Content>
                <StackPanel Orientation="Vertical" Spacing="10">
                    <SelectorBar HorizontalAlignment="Center" >
                        <SelectorBarItem Text="话题"></SelectorBarItem>
                        <SelectorBarItem Text="投票"></SelectorBarItem>
                    </SelectorBar>
                    <TextBox  Header="标题"></TextBox>
                </StackPanel>
            </ContentDialog.Content>
        </ContentDialog>
        <local:InfoFlower x:Name="Flower" Grid.Row="0" Grid.RowSpan="3" HorizontalAlignment="Center" VerticalAlignment="Bottom"></local:InfoFlower>
  
    </Grid>
</Page>
