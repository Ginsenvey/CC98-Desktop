<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="CC98.Views.SectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:dev="using:DevWinUI"
    xmlns:obj="using:CC98.Objects"
    xmlns:infoFlower="using:CC98.Controls.InfoFlower"
    Background="{ThemeResource DesktopAcrylicTransparentBrush}" Loaded="SectionPage_OnLoaded">
    <Page.Resources>
        <DataTemplate x:Key="BoardCase" x:DataType="obj:BoardInfo">
            <HyperlinkButton Content="{x:Bind Name}" Padding="8" Tag="{x:Bind Id}" Click="BoardButton_Click"
                             x:Name="BoardButton" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                             BorderThickness="1" Margin="10,0,10,10" />
        </DataTemplate>
        <DataTemplate x:Key="SectionCase" x:DataType="obj:SectionInfo">
            <StackPanel Orientation="Vertical" CornerRadius="5"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        Margin="10,10,10,10" Padding="10">
                <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="16" Margin="12,0,12,12" />
                <ItemsRepeater ItemTemplate="{StaticResource  BoardCase}" ItemsSource="{x:Bind Boards}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout ItemsJustification="Start" ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <dev:Stars />
        <Grid Background="{ThemeResource CardGradient2Brush}" Padding="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="版面" FontWeight="Bold" FontSize="22" Margin="10" />
            <ScrollViewer Grid.Row="1">
                <ItemsRepeater x:Name="SectionPresenter" ItemsSource="{x:Bind AllSections}"
                               ItemTemplate="{StaticResource SectionCase}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>
            <infoFlower:InfoFlower Grid.Row="0" Grid.RowSpan="2" x:Name="Flower" />
        </Grid>
    </Grid>

</Page>