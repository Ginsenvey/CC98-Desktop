<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CC98.Search"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CC98"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:obj="using:CC98.Objects"
    xmlns:cv="using:CC98.Services.Converters"
    Background="{ThemeResource DesktopAcrylicTransparentBrush}">

    <Grid Padding="15" RowSpacing="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Button x:Name="NaviBar" Grid.Column="0" Tag="Back" Click="NaviBar_Click" Padding="7">
                <ic:SymbolIcon Symbol="ChevronLeft"></ic:SymbolIcon>
            </Button>
            <Button Tag="Forward" Grid.Column="1" Click="NaviBar_Click" Padding="7">
                <ic:SymbolIcon Symbol="ChevronRight"></ic:SymbolIcon>
            </Button>
            <Button Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"  >
                <TextBlock Text="第 1 页" x:Name="PageIndex"  ></TextBlock>
            </Button>
        </Grid>
        <ScrollViewer  CornerRadius="5" Grid.Row="1" x:Name="RootViewer">
            <ItemsRepeater x:Name="SearchList" VerticalCacheLength="4">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Vertical" Spacing="10"></StackLayout>
                </ItemsRepeater.Layout>

                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="obj:TopicInfo">
                        <Grid Padding="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" RowSpacing="8" CornerRadius="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2*"></RowDefinition>
                                <RowDefinition Height="3*"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                            </Grid.RowDefinitions>

                            <HyperlinkButton Grid.Row="0" Margin="1,0,0,0"  x:Name="Person" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Tag="{x:Bind UserId}" BorderThickness="1" Click="Person_Click">
                                <TextBlock Text="{x:Bind UserName}" FontSize="12" VerticalAlignment="Center" ></TextBlock>

                            </HyperlinkButton>
                            <TextBlock Grid.Row="0" HorizontalAlignment="Right" Text="{x:Bind Time}"  FontSize="10"   Foreground="{ThemeResource TextFillColorSecondaryBrush}"></TextBlock>
                            <HyperlinkButton  Grid.Row="1" Padding="10"  Height="Auto" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"  Click="SearchContent_Click" Tag="{x:Bind Id}">
                                <TextBlock Text="{x:Bind Title}"  TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"></TextBlock>
                            </HyperlinkButton>
                            <StackPanel Orientation="Horizontal" Grid.Row="2" >
                                <Border Padding="8,0,8,0" Background="Transparent"  HorizontalAlignment="Left" >
                                    <StackPanel Orientation="Horizontal" Spacing="5" >
                                        <ic:SymbolIcon Symbol="Chat" FontSize="11"></ic:SymbolIcon>
                                        <TextBlock Text="{x:Bind ReplyCount}"   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"></TextBlock>
                                    </StackPanel>
                                </Border>
                             
                                <Border Padding="8,0,8,0" Background="Transparent"  HorizontalAlignment="Left"  >
                                    <StackPanel Orientation="Horizontal" Spacing="5" >
                                        <ic:SymbolIcon Symbol="Fire" FontSize="11" ></ic:SymbolIcon>
                                        <TextBlock Text="{x:Bind HitCount}"   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"></TextBlock>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                            <Button Grid.Row="2" HorizontalAlignment="Right" Background="Transparent" Margin="0,10,0,0">
                                <ic:SymbolIcon Symbol="MoreHorizontal" FontSize="11"></ic:SymbolIcon>
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="收藏" >
                                            <MenuFlyoutItem.Icon>
                                                <ic:FluentIcon Icon="StarAdd" ></ic:FluentIcon>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="复制帖子ID" >
                                            <MenuFlyoutItem.Icon>
                                                <ic:SymbolIcon Symbol="Link"></ic:SymbolIcon>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
        <local:InfoFlower x:Name="Flower" Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom"></local:InfoFlower>
    </Grid>
</Page>
