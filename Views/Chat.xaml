<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CC98.Chat"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CC98"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:image="using:CC98.Controls"
    xmlns:cv="using:CC98.Services.Converters"
    xmlns:obj="using:CC98.Objects"
    xmlns:ubb="using:UbbRender.Render"
    xmlns:share="using:CC98.Share.Controls"
    Background="{ThemeResource DesktopAcrylicTransparentBrush}">
   
    <Grid>
        <SplitView IsPaneOpen="True" DisplayMode="Inline" PaneBackground="Transparent" x:Name="MessageViewer">
            <SplitView.Pane>
                <ListView x:Name="UserList" SelectionChanged="ContactRepeater_SelectionChanged" ItemsSource="{x:Bind ChatInfoList}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="obj:ChatInfo">
                            <Grid Padding="10" RowSpacing="5" ColumnSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"></RowDefinition>
                                    <RowDefinition Height="*"></RowDefinition>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"></ColumnDefinition>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" CornerRadius="5" Height="45" Width="45">
                                    <share:Picture Src="{x:Bind PortraitUrl}" Stretch="UniformToFill" LoadImageCallback="{StaticResource PortraitLoader}"/>
                                </Border>
                                <TextBlock Text="{x:Bind Name}" Grid.Column="1" Grid.Row="0" FontSize="15"></TextBlock>
                                <TextBlock Text="{x:Bind LastContent}" Grid.Column="1" Grid.Row="1" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="1"></TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </SplitView.Pane>
            <SplitView.Content>
                <Grid Padding="15" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="130"></RowDefinition>
                        <RowDefinition Height="65"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button  Click="More_Click" x:Name="More" Padding="7" BorderThickness="0"  ToolTipService.ToolTip="查看更多">
                                <ic:SymbolIcon Symbol="ChevronUp"  FontSize="16"></ic:SymbolIcon>
                            </Button>
                            <Button  Click="Ref_Click" x:Name="Ref" Padding="7" BorderThickness="0"  ToolTipService.ToolTip="最新信息">
                                <ic:SymbolIcon Symbol="ArrowSync"  FontSize="16"></ic:SymbolIcon>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer x:Name="HistoryViewer" Grid.Row="1">
                        <ItemsRepeater Grid.Row="1" x:Name="MessagesList"  ItemsSource="{x:Bind Messages}" >
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="obj:ChatMessage">
                                    <Border Margin="0,10" HorizontalAlignment="{x:Bind IsMe,Converter={StaticResource AlignmentConverter}}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Background="Transparent" BorderThickness="1" CornerRadius="5" Padding="10" Height="Auto" MaxWidth="350" MinWidth="200">
                                        <StackPanel>
                                            <ubb:UbbTextBlock UbbText="{x:Bind Content}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" QuoteBackground="{ThemeResource QuoteBackgroundBrush}" BoldFontFamily="{StaticResource HarmonySansBold}"></ubb:UbbTextBlock>
                                            <TextBlock Text="{x:Bind Time}" Style="{ThemeResource CaptionTextBlockStyle}" HorizontalAlignment="Right" FontSize="10"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                    

                    <TextBox x:Name="ReplyBody" Grid.Row="2" AcceptsReturn="True" TextWrapping="Wrap" CornerRadius="5"  ></TextBox>
                    <Button x:Name="Send" Style="{ThemeResource AccentButtonStyle}" Grid.Row="3" HorizontalAlignment="Right"  Click="Send_Click">
                        <StackPanel Orientation="Horizontal" Spacing="10" >
                            <ic:SymbolIcon Symbol="Send"></ic:SymbolIcon>
                            <TextBlock Text="发送"></TextBlock>
                        </StackPanel>
                    </Button>
                </Grid>
            </SplitView.Content>
        </SplitView>
        <local:InfoFlower x:Name="Flower"  HorizontalAlignment="Center" VerticalAlignment="Bottom"></local:InfoFlower>
    </Grid>
    
</Page>
