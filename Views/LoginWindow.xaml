<?xml version="1.0" encoding="utf-8"?>

<Window
    x:Class="CC98.Views.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:dev="using:DevWinUI"
    xmlns:tool="using:CommunityToolkit.WinUI.Controls"
    xmlns:infoFlower="using:CC98.Controls.InfoFlower"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="RootGrid" UseLayoutRounding="True">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="68" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Width="1" BorderThickness="1" />
        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" x:Name="GridTitleBar" />
        <Grid Grid.Column="0" Grid.Row="1" Padding="20" x:Name="MainArea" RowSpacing="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="144" />
                <RowDefinition Height="Auto" />

            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="登录CC98" FontWeight="Bold" FontFamily="{StaticResource HarmonySansBold}"
                       FontSize="18" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}" />
            <Image Grid.Row="1" Source="/Assets/back.png" />
            <Border Grid.Row="2" Background="{ThemeResource AcrylicCardBrush}" CornerRadius="4" Padding="10">
                <TextBlock IsTextSelectionEnabled="False" FontSize="12" x:Name="Introducing"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="浙江大学校内论坛CC98的Windows客户端。使用本应用时，请阅读并遵守论坛规则。" TextWrapping="Wrap" />
            </Border>
        </Grid>
        <StackPanel Grid.Row="1" Grid.Column="2"  Padding="20" Spacing="10">
            <TextBlock Text="欢迎回家。" FontWeight="Bold" FontSize="18" Foreground="LightSeaGreen" />
            <tool:MarkdownTextBlock x:Name="tip" Grid.Row="1" Text="" Background="Transparent"
        Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
            <Button Grid.Row="2"  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Vertical" Padding="5">
                        <TextBlock Text="使用OpenID登录" FontWeight="Bold" />
                        <TextBlock Text="需要内网环境。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ic:SymbolIcon Symbol="ChevronRight" Grid.Column="1" />
                </Grid>

            </Button>
            <Button Grid.Row="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" x:Name="LinkToForum">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Vertical" Padding="5">
                        <TextBlock Text="使用密码登录" FontWeight="Bold" />
                        <TextBlock Text="在可信任的设备上使用此选项。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ic:SymbolIcon Symbol="ChevronRight" Grid.Column="1" />
                </Grid>

            </Button>
            <Button Grid.Row="4" x:Name="LinkToVpn"  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Vertical" Padding="5">
                        <TextBlock Text="连接到WebVPN" FontWeight="Bold" />
                        <TextBlock Text="使用VPN访问内网资源。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ic:SymbolIcon Symbol="ChevronRight" Grid.Column="1" />
                </Grid>
            </Button>
        </StackPanel>
        
        
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" Height="1"
                VerticalAlignment="Top" />
        <TextBlock Grid.Row="2" Grid.Column="0" Text="版本: v1.2.6 release."
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"
                   Margin="20,0,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="5" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Right"
                    Margin="0,0,20,0">
            <HyperlinkButton Background="Transparent" Padding="0" x:Name="Github"
                             NavigateUri="https://github.com/Ginsenvey/CC98-Desktop" ToolTipService.ToolTip="查看仓库"
                             Height="42" Width="42">
                <ImageIcon Source="/Assets/github.png" Width="25" Height="25" />
            </HyperlinkButton>
            <AppBarSeparator Margin="0,8,0,8" BorderThickness="4" />
            <HyperlinkButton Width="42" Height="42">
                <ic:SymbolIcon Symbol="Document" IconVariant="Color" />
            </HyperlinkButton>
            <HyperlinkButton Width="42" Height="42" Padding="0" NavigateUri="https://www.cc98.org">
                <ic:SymbolIcon Symbol="Home" IconVariant="Color" />
            </HyperlinkButton>
        </StackPanel>
        <infoFlower:InfoFlower x:Name="Flower" Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="3"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" />
    </Grid>
</Window>