<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CC98.Friend"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CC98"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:image="using:CC98.Controls"
    xmlns:ic="using:FluentIcons.WinUI" 
    Background="{ThemeResource DesktopAcrylicTransparentBrush}">

    <Grid Padding="15,0,15,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="75"></RowDefinition>
            <RowDefinition Height="12*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid  Grid.Row="0" Padding="10" >
            <TextBlock Text="关注" x:Name="FriendType" FontSize="24" FontWeight="Bold"   Foreground="#4d9891" VerticalAlignment="Center" HorizontalAlignment="Left"></TextBlock>
        </Grid>

        <ScrollViewer Grid.Row="1"  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="7" Margin="0,0,0,30">
            <ItemsRepeater  x:Name="Collection" Loaded="Collection_Loaded">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:Friends">
                        <HyperlinkButton HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" CornerRadius="0" x:Name="TileContent" Click="TileContent_Click" BorderThickness="0.5" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" DataContext="{x:Bind}">
                            <HyperlinkButton.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="私信"   Click="Chat_Click" >
                                        <MenuFlyoutItem.Icon>
                                            <ic:FluentIcon Icon="ChatAdd" ></ic:FluentIcon>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="取关"  Click="Follow_Click" Tag="{x:Bind uid}">
                                        <MenuFlyoutItem.Icon>
                                            <ic:FluentIcon Icon="PersonDelete" ></ic:FluentIcon>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </HyperlinkButton.ContextFlyout>
                            <Grid Padding="3,0,3,0"  ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="45"></ColumnDefinition>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                    <ColumnDefinition Width="50"></ColumnDefinition>
                                    <ColumnDefinition Width="200"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"></RowDefinition>
                                    <RowDefinition Height="*"></RowDefinition>
                                </Grid.RowDefinitions>
                                <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Width="40" Height="40"  VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="3">
                                    <image:SmartImage Source="{x:Bind url}" Stretch="UniformToFill"></image:SmartImage>
                                </Border>
                                
                                <TextBlock Text="{x:Bind name}" Grid.Column="1" Grid.Row="0" Grid.RowSpan="2"  VerticalAlignment="Center"></TextBlock>
                                <TextBlock Text="帖数" Grid.Column="2" Grid.Row="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"></TextBlock>
                                <TextBlock Text="粉丝" Grid.Column="2" Grid.Row="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}"></TextBlock>
                                <TextBlock Text="{x:Bind post}" Grid.Column="3" Grid.Row="0"  VerticalAlignment="Center" ></TextBlock>
                                <TextBlock Text="{x:Bind follower}" Grid.Column="3" Grid.Row="1"  VerticalAlignment="Bottom" ></TextBlock>

                            </Grid>
                        </HyperlinkButton>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <local:InfoFlower HorizontalAlignment="Center" x:Name="Flower"  Grid.Row="0" Grid.RowSpan="2" ></local:InfoFlower>
    </Grid>
</Page>
