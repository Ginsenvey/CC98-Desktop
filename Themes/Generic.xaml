<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CC98.Controls"
    xmlns:ubb="using:UbbRender.Render"
    xmlns:render="using:CC98.Controls">

    <Style TargetType="local:SmartImage" >
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SmartImage">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ubb:UbbTextBlock">
        <Setter Property="Background" Value="Transparent"/>
       
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ubb:UbbTextBlock">
                    <Border
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">

                        <StackPanel x:Name="PART_RootPanel" Margin="{TemplateBinding Padding}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    
</ResourceDictionary>
